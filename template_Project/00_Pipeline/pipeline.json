            {
                "description": "Run test.py",
                "dftTasks": {
                    "departments": [
                        "*"
                    ],
                    "entities": [
                        "*"
                    ],
                    "expression": "# set the variable \"result\" to True or False to decide when the default preset scenefile should get applied.\n# Example:\n#\n# context = core.getScenefileData(core.getCurrentFileName())\n# if context.get(\"department\") == \"rig\":\n#     result = True\n# else:\n#     result = False",
                    "tasks": [
                        "*"
                    ],
                    "useExpression": false
                },
                "enabled": true,
                "function": "self.core.entities.buildSceneRunCode",
                "label": "Run Code",
                "name": "runCode",
                "settings": [
                    {
                        "label": "Code",
                        "type": "code",
                        "value": "# Available variables: core, self, context, step\ntry:\n    from DaisyTools.core.test import Test\n    test = Test(core=self.core)\n    test.run()\nexcept Exception as e:\n    self.core.popup(\"Erreur lors du lancement du test: %s\" % e)"
                    }
                ]
            }
        ]
